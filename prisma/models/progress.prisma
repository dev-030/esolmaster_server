model StudentMonthlyStats {
  id                 String   @id @default(nanoid())
  studentId          String
  month              Int
  year               Int
  completedTasks     Int      @default(0)
  grammarScoreAvg    Float    @default(0)
  readingScoreAvg    Float    @default(0)
  vocabularyScoreAvg Float    @default(0)
  overallScoreAvg    Float    @default(0)
  xpEarned           Int      @default(0)
  createdAt          DateTime @default(now())
  listeningScoreAvg  Float    @default(0)
  speakingScoreAvg   Float    @default(0)
  writingScoreAvg    Float    @default(0)
  student            User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, month, year])
}

model StudentSkillProgress {
  id             String    @id @default(nanoid())
  studentId      String
  skill          SkillType
  totalTasks     Int       @default(0)
  completedTasks Int       @default(0)
  avgScore       Float     @default(0)
  totalScore     Float     @default(0)
  updatedAt      DateTime  @updatedAt
  student        User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, skill])
}

enum SkillType {
  GRAMMAR
  READING
  VOCABULARY
  WRITING
  LISTENING
  SPEAKING
}
