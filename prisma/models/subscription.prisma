model SubscriptionPlan {
  id                       String               @id @default(nanoid())
  name                     String
  type                     SubscriptionPlanType @unique
  monthlyPrice             Int                  @default(0)
  annualPrice              Int                  @default(0)
  stripeProductId          String?
  stripeMonthlyPriceId     String?
  stripeAnnualPriceId      String?
  maxClasses               Int
  maxStudentsPerClass      Int
  maxScheduledTasksInClass Int
  isActive                 Boolean              @default(true)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  premiumTasks             PlanPremiumTask[]
  subscriptions            UserSubscription[]
}

model PlanPremiumTask {
  id        String           @id @default(nanoid())
  planId    String
  taskId    String
  createdAt DateTime         @default(now())
  plan      SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  task      Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([planId, taskId])
  @@index([planId])
  @@index([taskId])
}

model UserSubscription {
  id                   String           @id @default(nanoid())
  userId               String           @unique
  planId               String
  billingCycle         BillingCycle?
  billingStatus        BillingStatus    @default(ACTIVE)
  boughtPrice          Int              @default(0)
  discountAmount       Int              @default(0)
  finalPrice           Int              @default(0)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  trialStart           DateTime?
  trialEnd             DateTime?
  cancelAtPeriodEnd    Boolean          @default(false)
  canceledAt           DateTime?
  changedByAdminId     String?
  changedAt            DateTime?
  expiryNotifiedAt     DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  plan                 SubscriptionPlan @relation(fields: [planId], references: [id])
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([billingStatus])
}

enum SubscriptionPlanType {
  FREE
  BASIC
  PRO
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum BillingStatus {
  ACTIVE
  PAST_DUE
  TRIALING
  CANCELED
  CANCELING
}
