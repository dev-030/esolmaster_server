model StudentActivity {
  id              String              @id @default(nanoid())
  studentId       String
  type            StudentActivityType
  scheduledTaskId String?
  attemptId       String?
  xpEarned        Int                 @default(0)
  message         String?
  createdAt       DateTime            @default(now())
  attempt         Attempt?            @relation(fields: [attemptId], references: [id])
  scheduledTask   ClassScheduledTask? @relation(fields: [scheduledTaskId], references: [id])
  student         User                @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Badge {
  id              String             @id @default(nanoid())
  name            String             @unique
  description     String
  iconName        String
  conditionType   BadgeConditionType
  conditionConfig Json
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  studentBadges   StudentBadge[]
}

model StudentBadge {
  id        String    @id @default(nanoid())
  studentId String
  badgeId   String
  progress  Int       @default(0)
  earnedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  badge     Badge     @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  student   User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, badgeId])
  @@index([studentId])
  @@index([badgeId])
}

enum StudentActivityType {
  TASK_COMPLETED
  LEVEL_UP
  BADGE_EARNED
}

enum BadgeConditionType {
  COMPLETE_TASKS_WITHIN_DAYS
  SCORE_PERCENTAGE
  CONSECUTIVE_SCORE_PERCENTAGE
  SCORE_PERCENTAGE_IN_TASKS_WITHIN_DAYS
  XP_WITHIN_TIME
  STREAK_DAYS
  ATTEMPT_COUNT
}
