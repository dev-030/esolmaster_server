model Class {
  id          String      @id @default(nanoid())
  name        String
  subject     String
  description String?
  color       String
  maxStudents Int?
  teacherId   String
  joinCode    String          @unique
  joinStatus  ClassJoinStatus @default(OPEN)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  teacher     User        @relation("TeacherClasses", fields: [teacherId], references: [id])
  classTasks  ClassTask[]
  students    User[]      @relation("StudentClasses")

  @@index([teacherId])
}

enum ClassJoinStatus {
  OPEN
  PAUSED
  CLOSED
}

model ClassTask {
  id            String              @id @default(nanoid())
  classId       String
  taskId        String
  addedAt       DateTime            @default(now())
  scheduledTask ClassScheduledTask?
  class         Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  task          Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([classId, taskId])
  @@index([classId])
}

model ClassScheduledTask {
  id                   String            @id @default(nanoid())
  scheduledAt          DateTime          @default(now())
  dueAt                DateTime?
  isActive             Boolean           @default(true)
  openedNotifiedAt     DateTime?
  endingSoonNotifiedAt DateTime?
  classTaskId          String            @unique
  attempts             Attempt[]
  classTask            ClassTask         @relation(fields: [classTaskId], references: [id], onDelete: Cascade)
  studentActivities    StudentActivity[]

  @@index([scheduledAt])
  @@index([isActive, dueAt])
}
