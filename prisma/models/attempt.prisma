model Attempt {
  id                   String             @id @default(nanoid())
  studentId            String
  taskId               String
  isPassed             Boolean            @default(false)
  achievedCriteria     String[]
  missingCriteria      String[]
  xpEarned             Int                @default(0)
  percentage           Float?
  scheduledTaskId      String
  status               AttemptStatus      @default(IN_PROGRESS)
  currentQuestionIndex Int                @default(0)
  score                Int                @default(0)
  startedAt            DateTime           @default(now())
  completedAt          DateTime?
  scheduledTask        ClassScheduledTask @relation(fields: [scheduledTaskId], references: [id], onDelete: Cascade)
  student              User               @relation(fields: [studentId], references: [id])
  task                 Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  studentActivities    StudentActivity[]
  answers              StudentAnswer[]

  @@unique([studentId, scheduledTaskId])
  @@index([studentId, status, completedAt])
  @@index([status, completedAt])
  @@index([scheduledTaskId, status])
  @@index([taskId])
}

model StudentAnswer {
  id         String   @id @default(nanoid())
  attemptId  String
  questionId String
  answerData Json
  isCorrect  Boolean
  answeredAt DateTime @default(now())
  attempt    Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([questionId])
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
}
